<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai.ecosystem.bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>__USER_HOME__/ai-env/bin/python3</string>
        <string>__USER_HOME__/ai-ecosystem/telegram_bot/bot.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__USER_HOME__/ai-ecosystem</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__USER_HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONPATH</key>
        <string>__USER_HOME__/ai-ecosystem</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__USER_HOME__/ai-ecosystem/bot.log</string>
    <key>StandardErrorPath</key>
    <string>__USER_HOME__/ai-ecosystem/bot.err.log</string>
</dict>
</plist>
