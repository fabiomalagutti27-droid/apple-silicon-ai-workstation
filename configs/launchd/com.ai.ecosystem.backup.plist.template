<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai.ecosystem.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__USER_HOME__/Vault/02_Progetti/AI_Ecosystem/apple-silicon-ai-workstation/scripts/backup_to_gdrive.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__USER_HOME__</string>
    <!-- Esecuzione settimanale: Ogni domenica alle ore 03:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__USER_HOME__</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__USER_HOME__/.ai-backups/backup.log</string>
    <key>StandardErrorPath</key>
    <string>__USER_HOME__/.ai-backups/backup.err.log</string>
</dict>
</plist>
