# ==============================================================================
# .env.example - Configurazione d'Ambiente Apple Silicon AI Workstation
# Copia questo file in .env e inserisci le tue chiavi e ID reali
# ==============================================================================

# Rete e Host Mac mini
MAC_MINI_HOST=127.0.0.1
MAC_MINI_TAILSCALE_IP=100.73.59.49
MAC_MINI_PORT=8000
LLAMA_SWAP_PORT=8000
DSH_PORT=3082
OPENCODE_PORT=49374

# Telegram Bot Hub
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_TELEGRAM_USER_ID=0

# Servizi Satellite & Crawler
FIRECRAWL_API_KEY=fc-your-api-key-here
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
LOCAL_LLM_KEY=unused

# Backup Cloud (rclone Google Drive)
RCLONE_REMOTE_NAME=gdrive
RCLONE_BACKUP_PATH=Backups/MacMini_M5Pro_AI_Workstation
